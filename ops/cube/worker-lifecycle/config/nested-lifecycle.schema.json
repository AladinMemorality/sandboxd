{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baarcha:cube:nested-lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reviewed",
    "machine_id",
    "data_filesystem_uuid",
    "binaries",
    "artifacts",
    "durable_metadata_reviewed",
    "durable_metadata_paths",
    "registry"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "reviewed": {
      "const": true
    },
    "machine_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "data_filesystem_uuid": {
      "type": "string",
      "pattern": "^[a-f0-9-]{32,64}$"
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cubelet",
        "cubemaster",
        "cube-api"
      ],
      "properties": {
        "cubelet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/usr/local/services/[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "cubemaster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/usr/local/services/[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "cube-api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/usr/local/services/[^\\u0000]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(/(etc/systemd/system|usr/local/services)/[^\\u0000]+|/usr/local/libexec/baarcha-cube-worker-lifecycle\\.py)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "durable_metadata_reviewed": {
      "const": true
    },
    "durable_metadata_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/data/[^\\u0000]+$"
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "image",
        "restart",
        "ports",
        "mounts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
          "const": "/cube-production-registry"
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "restart": {
          "const": {
            "Name": "always",
            "MaximumRetryCount": 0
          }
        },
        "ports": {
          "const": {
            "5000/tcp": [
              {
                "HostIp": "127.0.0.1",
                "HostPort": "5000"
              }
            ]
          }
        },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "Type",
              "Source",
              "Destination",
              "RW"
            ],
            "properties": {
              "Type": {
                "enum": [
                  "bind",
                  "volume"
                ]
              },
              "Source": {
                "type": "string",
                "pattern": "^/[^\\u0000]+$"
              },
              "Destination": {
                "const": "/var/lib/registry"
              },
              "RW": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}

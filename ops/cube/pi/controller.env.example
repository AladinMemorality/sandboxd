# Add only the exact template ID produced by the Pi candidate registration.
# Empty disables Pi. This does not remap existing runtime presets or projects.
SANDBOXD_CUBE_PI_TEMPLATES=
SANDBOXD_DEFAULT_AGENT=claude-code
# Keep the existing task-scoped relay and credential proxy configured.
# Pi shares the Anthropic-compatible gateway; no Pi login or provider key in VMs.

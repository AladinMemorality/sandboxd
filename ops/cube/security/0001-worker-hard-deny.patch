+package cubevs
+
+import (
+    "os"
+    "testing"
+)
+
+// Run on the actual worker: skipped BPF tests do NOT attest enforcement.
+func TestBaarchaHardDenyOverridesAllowAndCachedSession(t *testing.T) {
+    management := os.Getenv("CUBE_HARD_DENY_TEST_MANAGEMENT_IP")
+    if management == "" { t.Fatal("set CUBE_HARD_DENY_TEST_MANAGEMENT_IP to a protected worker/control-plane IPv4 address") }
+    env := loadEgressPolicyTestEnv(t)
+    for index, address := range []string{"10.1.2.3", "127.0.0.1", "100.64.0.1", "169.254.169.254", "172.16.0.1", "192.168.0.1", "224.0.0.1", management} {
+        ifindex := uint32(900+index)
+        allow, _ := env.attachInnerMaps(t, ifindex)
+        daddr := mustParseCIDRForTest(t, address).IP
+        key := lpmKeyV3{Prefixlen:32,IP:daddr}
+        value := netPolicyValueV3{KeyPrefixlen:32}
+        if err := allow.Put(&key,&value);err!=nil{t.Fatal(err)}
+        for _, protocol := range []uint8{ipprotoTCP,ipprotoUDP,ipprotoICMP} {
+            if got:=runEgressPolicyCaseProto(t,env.program,ifindex,daddr,htonsPort(443),protocol);got!=flowVerdictReject {t.Fatalf("protected %s protocol%d allowed despite hard deny",address,protocol)}
+            result:=runSessionRecheckCase(t,env.recheckProgram,sessionRecheckCase{ifindex:ifindex,daddr:daddr,dport:htonsPort(443),protocol:protocol,sessPolicyVersion:1,metaPolicyVersion:1})
+            if !result.revoked {t.Fatalf("cached flow to %s protocol%d escaped hard deny",address,protocol)}
+        }
+    }
+}

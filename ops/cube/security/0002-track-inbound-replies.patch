--- /dev/null
+++ b/CubeNet/src/baarcha_reply.h
@@ -0,0 +1,54 @@
+/* Worker-owned permissions for responses to real inbound TCP connections. */
+#ifndef BAARCHA_REPLY_H
+#define BAARCHA_REPLY_H
+struct baarcha_reply_key {
+    __u32 ifindex;
+    __u32 peer_ip;
+    __u16 peer_port;
+    __u16 guest_port;
+};
+struct baarcha_reply_value {
+    __u64 last_seen;
+    __u32 generation;
+    __u32 pad;
+};
+struct {
+    __uint(type, BPF_MAP_TYPE_LRU_HASH);
+    __uint(max_entries, 65536);
+    __type(key, struct baarcha_reply_key);
+    __type(value, struct baarcha_reply_value);
+    __uint(pinning, LIBBPF_PIN_BY_NAME);
+} baarcha_replies SEC(".maps");
+#define BAARCHA_REPLY_IDLE_NS (3600ULL * 1000000000ULL)
+static __always_inline bool baarcha_reply_allowed(__u32 ifindex, __u32 peer,
+                                                  __u16 peer_port, __u16 guest_port)
+{
+    struct baarcha_reply_key key = {.ifindex=ifindex, .peer_ip=peer,
+        .peer_port=peer_port, .guest_port=guest_port};
+    struct baarcha_reply_value *value = bpf_map_lookup_elem(&baarcha_replies, &key);
+    struct mvm_meta *meta = bpf_map_lookup_elem(&ifindex_to_mvmmeta, &ifindex);
+    __u64 now = bpf_ktime_get_ns();
+    if (!value || !meta || value->generation != meta->version ||
+        now - value->last_seen > BAARCHA_REPLY_IDLE_NS)
+        return false;
+    value->last_seen = now;
+    return true;
+}
+static __always_inline bool baarcha_track_reply(__u32 ifindex, __u32 peer,
+                                                __u16 peer_port, __u16 guest_port,
+                                                bool syn, bool ack)
+{
+    struct baarcha_reply_key key = {.ifindex=ifindex, .peer_ip=peer,
+        .peer_port=peer_port, .guest_port=guest_port};
+    struct mvm_meta *meta;
+    struct baarcha_reply_value value = {};
+    if (!syn || ack)
+        return baarcha_reply_allowed(ifindex, peer, peer_port, guest_port);
+    meta = bpf_map_lookup_elem(&ifindex_to_mvmmeta, &ifindex);
+    if (!meta)
+        return false;
+    value.generation = meta->version;
+    value.last_seen = bpf_ktime_get_ns();
+    return bpf_map_update_elem(&baarcha_replies, &key, &value, BPF_ANY) == 0;
+}
+#endif

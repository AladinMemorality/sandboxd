+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+package sandbox
+
+import (
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox/types"
+)
+
+// clonePausedSandboxData only accepts the requested node record. A pause
+// binding must not borrow another sandbox's identity or resource allocation.
+func clonePausedSandboxData(rows []*types.SandboxData, id string) *types.SandboxData {
+	for _, row := range rows {
+		if row == nil || row.SandboxID != id {
+			continue
+		}
+		out := *row
+		out.Annotations = cloneStringMap(row.Annotations)
+		out.Labels = cloneStringMap(row.Labels)
+		out.Containers = nil
+		for _, c := range row.Containers {
+			if c != nil {
+				copy := *c
+				out.Containers = append(out.Containers, &copy)
+			}
+		}
+		return &out
+	}
+	return nil
+}
+
+func applyPausedSandboxState(row *types.SandboxData, state int32, annotations map[string]string) {
+	row.Status = state
+	if row.Annotations == nil {
+		row.Annotations = make(map[string]string)
+	}
+	for key, value := range annotations {
+		row.Annotations[key] = value
+	}
+	for _, c := range row.Containers {
+		c.Status = state
+	}
+}
+
+// pausedDataFromSpec is a fallback only when no node summary exists. Do not
+// resolve current template defaults: those need not match this sandbox's
+// allocation. Missing canonical fields stay unknown for callers to reject.
+// Never expose private create annotations (including env bootstrap tokens).
+func pausedDataFromSpec(id string, spec *types.CreateCubeSandboxReq) *types.SandboxData {
+	row := &types.SandboxData{
+		SandboxID:   id,
+		NameSpace:   spec.Namespace,
+		Labels:      cloneStringMap(spec.Labels),
+		Annotations: buildAnnotationsFromLabels(spec.Labels),
+		TemplateID:  templateIDFromLabels(spec.Labels),
+	}
+	if row.TemplateID == "" {
+		row.TemplateID = spec.Annotations[constants.CubeAnnotationAppSnapshotTemplateID]
+	}
+	for i, c := range spec.Containers {
+		if c == nil {
+			continue
+		}
+		info := &types.ContainerInfo{Name: c.Name, ContainerID: c.Id}
+		if i == 0 {
+			info.ContainerID = id
+		}
+		if c.Image != nil {
+			info.Image = c.Image.Image
+		}
+		if c.Resources != nil {
+			info.Cpu = c.Resources.Cpu
+			info.Mem = c.Resources.Mem
+			info.CpuMilli = parseCPUMilli(c.Resources.Cpu)
+			info.MemoryMiB = parseMemoryMiB(c.Resources.Mem)
+		}
+		row.Containers = append(row.Containers, info)
+	}
+	return row
+}

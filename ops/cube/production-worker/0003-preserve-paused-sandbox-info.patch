+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+package sandbox
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox/types"
+	"github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+)
+
+func TestPausedInfoRetainsActualAllocationAndIdentity(t *testing.T) {
+	original := &types.SandboxData{
+		SandboxID: "owned", TemplateID: "tpl-original", NameSpace: "default", EndAt: 123,
+		Labels:      map[string]string{"owner": "alice", "fixture": "restart"},
+		Annotations: map[string]string{"existing": "preserve"},
+		Containers:  []*types.ContainerInfo{{ContainerID: "owned", Cpu: "1500m", Mem: "3Gi", CpuMilli: 1500, MemoryMiB: 3072, CreateAt: 42, Status: 2}},
+	}
+	row := clonePausedSandboxData([]*types.SandboxData{nil, {SandboxID: "other"}, original}, "owned")
+	require.NotNil(t, row)
+	applyPausedSandboxState(row, int32(cubebox.ContainerState_CONTAINER_PAUSED), map[string]string{constants.CubeAnnotationPauseSnapshotID: "snap-owned"})
+	require.Equal(t, "tpl-original", row.TemplateID)
+	require.Equal(t, original.Labels, row.Labels)
+	require.Equal(t, "preserve", row.Annotations["existing"])
+	require.EqualValues(t, 1500, row.Containers[0].CpuMilli)
+	require.EqualValues(t, 3072, row.Containers[0].MemoryMiB)
+	require.EqualValues(t, 42, row.Containers[0].CreateAt)
+	require.EqualValues(t, 123, row.EndAt)
+	require.EqualValues(t, cubebox.ContainerState_CONTAINER_PAUSED, row.Status)
+	require.EqualValues(t, cubebox.ContainerState_CONTAINER_PAUSED, row.Containers[0].Status)
+	row.Labels["owner"] = "modified"
+	row.Annotations["existing"] = "modified"
+	row.Containers[0].CpuMilli = 99
+	require.Equal(t, "alice", original.Labels["owner"])
+	require.Equal(t, "preserve", original.Annotations["existing"])
+	require.EqualValues(t, 1500, original.Containers[0].CpuMilli)
+	require.EqualValues(t, 2, original.Containers[0].Status)
+}
+
+func TestPausedInfoDoesNotBorrowAnotherSandbox(t *testing.T) {
+	require.Nil(t, clonePausedSandboxData([]*types.SandboxData{{SandboxID: "other", TemplateID: "wrong", Labels: map[string]string{"owner": "bob"}}}, "owned"))
+}
+
+func TestPausedInfoCanonicalFallbackKeepsOnlyPublicIdentity(t *testing.T) {
+	spec := &types.CreateCubeSandboxReq{
+		Namespace: "default", Labels: map[string]string{"owner": "alice"},
+		Annotations:       map[string]string{constants.CubeAnnotationAppSnapshotTemplateID: "tpl-original", "cube.master.create_time_env_vars": "private-token"},
+		CreateTimeEnvVars: map[string]string{"RUNTIMED_HTTP_TOKEN": "private-token"},
+		Containers:        []*types.Container{{Name: "main", Resources: &types.Resource{Cpu: "2500m", Mem: "1536Mi"}}},
+	}
+	row := pausedDataFromSpec("owned", spec)
+	require.Equal(t, "tpl-original", row.TemplateID)
+	require.Equal(t, "owned", row.Containers[0].ContainerID)
+	require.EqualValues(t, 2500, row.Containers[0].CpuMilli)
+	require.EqualValues(t, 1536, row.Containers[0].MemoryMiB)
+	require.Equal(t, "alice", row.Labels["owner"])
+	require.NotContains(t, row.Annotations, "cube.master.create_time_env_vars")
+	row.Labels["owner"] = "changed"
+	require.Equal(t, "alice", spec.Labels["owner"])
+}
+
+func TestPausedInfoMissingCanonicalFieldsRemainUnknown(t *testing.T) {
+	row := pausedDataFromSpec("owned", &types.CreateCubeSandboxReq{})
+	applyPausedSandboxState(row, int32(cubebox.ContainerState_CONTAINER_PAUSED), nil)
+	require.Empty(t, row.TemplateID)
+	require.Empty(t, row.Labels)
+	require.Empty(t, row.Containers)
+	require.EqualValues(t, cubebox.ContainerState_CONTAINER_PAUSED, row.Status)
+}
+
+func TestPauseFailureDoesNotReportRunning(t *testing.T) {
+	row := clonePausedSandboxData([]*types.SandboxData{{SandboxID: "owned", Containers: []*types.ContainerInfo{{ContainerID: "owned", Status: 1}}}}, "owned")
+	applyPausedSandboxState(row, int32(cubebox.ContainerState_CONTAINER_UNKNOWN), map[string]string{constants.CubeAnnotationPauseError: "failed"})
+	require.EqualValues(t, cubebox.ContainerState_CONTAINER_UNKNOWN, row.Status)
+	require.EqualValues(t, cubebox.ContainerState_CONTAINER_UNKNOWN, row.Containers[0].Status)
+}

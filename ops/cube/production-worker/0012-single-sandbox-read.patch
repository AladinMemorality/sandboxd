+    #[tokio::test]
+    async fn single_get_never_scans_inventory_and_preserves_detail() {
+        // No list route exists: any inventory fallback makes this fail, even
+        // when the individual sandbox lookup is healthy.
+        for (native_state, expected) in [
+            (1, SandboxState::Running),
+            (5, SandboxState::Paused),
+            (2, SandboxState::Stopped),
+            (3, SandboxState::Unknown),
+        ] {
+            for end_at in [serde_json::Value::Null, serde_json::json!("2026-09-29T00:00:00Z")] {
+                let value = serde_json::json!({
+                    "requestID": "single-get",
+                    "ret": {"ret_code": 200, "ret_msg": "ok"},
+                    "data": [{
+                        "sandbox_id": "sb-single", "host_id": "worker-100",
+                        "template_id": "tpl-1", "status": native_state,
+                        "end_at": end_at,
+                        "containers": [{"container_id":"sb-single", "type":"sandbox",
+                            "create_at": 1790467200000000000_i64,
+                            "cpu_milli": 2000, "memory_mib": 2048}]
+                    }]
+                });
+                let service = spawn_fake_cubemaster(Router::new().route(
+                    "/cube/sandbox/info",
+                    axum::routing::get(move || {let value=value.clone(); async move {Json(value)}}),
+                )).await;
+                let result = service.get_sandbox("sb-single").await.expect("single-ID lookup");
+                assert_eq!(result.state, expected);
+                assert_eq!(result.started_at.timestamp(), 1790467200);
+                assert_eq!(result.end_at.is_none(), end_at.is_null());
+                if let Some(end) = result.end_at {
+                    assert_eq!(end.to_rfc3339(), "2026-09-29T00:00:00+00:00");
+                }
+                assert_eq!(result.cpu_count, 2);
+                assert_eq!(result.memory_mb, 2048);
+                assert_eq!(result.client_id, "worker-100");
+            }
+        }
+    }
+

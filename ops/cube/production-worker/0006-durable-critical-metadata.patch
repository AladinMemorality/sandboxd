+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package durability
+
+import (
+	"errors"
+	"os"
+	"syscall"
+)
+
+func checkOwnedRoot(info os.FileInfo) error {
+	if info.Sys().(*syscall.Stat_t).Uid != 0 {
+		return errors.New("durable root must be root-owned")
+	}
+	return nil
+}
+func checkXFS(path string) error {
+	var s syscall.Statfs_t
+	if err := syscall.Statfs(path, &s); err != nil {
+		return err
+	}
+	if uint64(s.Type) != 0x58465342 {
+		return errors.New("durable metadata requires verified XFS, never tmpfs/ramfs/overlay")
+	}
+	return nil
+}

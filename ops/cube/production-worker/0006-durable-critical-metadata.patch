+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+	"context"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/internal/durability"
+	srvconfig "github.com/tencentcloud/CubeSandbox/Cubelet/services/server/config"
+)
+
+func validateDurableMetadata(ctx context.Context, config *srvconfig.Config) error {
+	if config.DurableMetadataRoot == "" {
+		return nil
+	}
+	paths := map[string]string{}
+	var noSync *bool
+	for plugin := range durability.MetadataPaths {
+		var pc struct {
+			RootPath  string `toml:"root_path"`
+			StatePath string `toml:"state_path"`
+			NoSync    *bool  `toml:"no_sync"`
+		}
+		if _, err := config.Decode(ctx, plugin, &pc); err != nil {
+			return err
+		}
+		paths[plugin] = pc.RootPath
+		if plugin == "io.cubelet.internal.v1.images" {
+			paths[plugin] = pc.StatePath
+		}
+		if plugin == "io.containerd.metadata.v1.bolt" {
+			noSync = pc.NoSync
+		}
+	}
+	if err := durability.ValidatePaths(config.DurableMetadataRoot, config.State, paths, noSync); err != nil {
+		return err
+	}
+	if err := durability.CheckFilesystem(config.DurableMetadataRoot, paths); err != nil {
+		return err
+	}
+	return durability.CheckLegacyState(config.State)
+}

+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package utils
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// A synced new Bolt file alone does not durably link newly created directories.
+// Sync ancestors before returning a database that may acknowledge tenant state.
+func syncDatabaseDirectory(file string) error {
+	absolute, err := filepath.Abs(file)
+	if err != nil {
+		return err
+	}
+	for dir := filepath.Dir(absolute); ; dir = filepath.Dir(dir) {
+		f, err := os.Open(dir)
+		if err != nil {
+			return err
+		}
+		err = f.Sync()
+		closeErr := f.Close()
+		if err != nil {
+			return err
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		if dir == filepath.Dir(dir) {
+			return nil
+		}
+	}
+}

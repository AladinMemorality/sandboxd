+package utils
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestSyncDirectoryFailsForMissingParent(t *testing.T) {
+	if syncDatabaseDirectory(filepath.Join(t.TempDir(), "absent", "db")) == nil {
+		t.Fatal("missing parent silently accepted")
+	}
+}
+func TestSyncDirectoryPreservesNestedPathAndContent(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "new", "nested", "meta.db")
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("acknowledged"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := syncDatabaseDirectory(path); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil || string(b) != "acknowledged" {
+		t.Fatal("unexpected mutation")
+	}
+}

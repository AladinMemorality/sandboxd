+package utils
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDurableDatabaseDefaultsAndAcknowledgedReopen(t *testing.T) {
+	opts := MakeBoltDBOption()
+	if opts.NoSync || opts.NoGrowSync {
+		t.Fatal("metadata acknowledgements must sync data and growth")
+	}
+	dir := filepath.Join(t.TempDir(), "new", "nested")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	db, err := NewCubeStoreExt(dir, "meta.db", 2, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = db.SetWithTx("sandbox/v1", "owned", []byte("latest-current-disk-binding"), nil); err != nil {
+		t.Fatal(err)
+	}
+	if err = db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	db, err = NewCubeStoreExt(dir, "meta.db", 2, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	values, err := db.ReadAll("sandbox/v1")
+	if err != nil || string(values["owned"]) != "latest-current-disk-binding" {
+		t.Fatal("acknowledged metadata absent", err)
+	}
+}

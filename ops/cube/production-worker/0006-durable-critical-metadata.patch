+package durability
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestEveryCriticalPluginMustBeExplicitAndOutsideVolatileState(t *testing.T) {
+	root := "/data/cubelet/persistent-metadata"
+	paths := map[string]string{}
+	for p, d := range MetadataPaths {
+		paths[p] = filepath.Join(root, d)
+	}
+	noSync := false
+	if err := ValidatePaths(root, "/data/cubelet/state", paths, &noSync); err != nil {
+		t.Fatal(err)
+	}
+	for p := range paths {
+		old := paths[p]
+		paths[p] = "/data/cubelet/state/legacy"
+		if ValidatePaths(root, "/data/cubelet/state", paths, &noSync) == nil {
+			t.Fatal(p)
+		}
+		paths[p] = old
+	}
+	for _, state := range []string{root, filepath.Dir(root), root + "/runtime"} {
+		if ValidatePaths(root, state, paths, &noSync) == nil {
+			t.Fatal("overlap accepted")
+		}
+	}
+	noSync = true
+	if ValidatePaths(root, "/data/cubelet/state", paths, &noSync) == nil {
+		t.Fatal("unsynced database accepted")
+	}
+	if ValidatePaths(root, "/data/cubelet/state", paths, nil) == nil {
+		t.Fatal("implicit unsafe default accepted")
+	}
+}
+func TestLegacyDatabaseAndSymlinkAreNeverMigratedOrDeleted(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "io.cubelet.internal.v1.cubebox", "db")
+	os.MkdirAll(p, 0700)
+	file := filepath.Join(p, "meta.db")
+	os.WriteFile(file, []byte("retained acknowledged identities"), 0600)
+	if CheckLegacyState(dir) == nil {
+		t.Fatal("legacy metadata ignored")
+	}
+	b, err := os.ReadFile(file)
+	if err != nil || string(b) != "retained acknowledged identities" {
+		t.Fatal("source mutated")
+	}
+	os.Remove(file)
+	if err := CheckLegacyState(dir); err != nil {
+		t.Fatal(err)
+	}
+	os.Symlink(t.TempDir(), filepath.Join(p, "link"))
+	if CheckLegacyState(dir) == nil {
+		t.Fatal("symlink accepted")
+	}
+}
+func TestVolatileFilesystemRejected(t *testing.T) {
+	if _, err := os.Stat("/dev/shm"); err != nil {
+		t.Skip("Linux tmpfs required")
+	}
+	if checkXFS("/dev/shm") == nil {
+		t.Fatal("tmpfs accepted as durable")
+	}
+}
+
+func TestLegacyGuardDoesNotParseRuntimeGuestMounts(t *testing.T) {
+	root := t.TempDir()
+	runtime := filepath.Join(root, "io.containerd.runtime.v2.task", "default", "owned")
+	os.MkdirAll(runtime, 0700)
+	os.Symlink("/untrusted-guest-root", filepath.Join(runtime, "rootfs"))
+	if err := CheckLegacyState(root); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestMetadataGuardDoesNotTraverseOverlaySnapshotContents(t *testing.T) {
+	root := t.TempDir()
+	snapshots := filepath.Join(root, "overlayfs", "io.containerd.snapshotter.v1.overlayfs", "snapshots")
+	if err := os.MkdirAll(filepath.Join(snapshots, "1", "fs"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("/not-inspected", filepath.Join(snapshots, "1", "fs", "image-link")); err != nil {
+		t.Fatal(err)
+	}
+	if err := checkMetadataTree(root, func(string) error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("/wrong-index", filepath.Join(filepath.Dir(snapshots), "metadata.db")); err != nil {
+		t.Fatal(err)
+	}
+	if err := checkMetadataTree(root, func(string) error { return nil }); err == nil {
+		t.Fatal("metadata DB symlink accepted")
+	}
+}

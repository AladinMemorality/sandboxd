@@ -0,0 +1,159 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+package durability
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// MetadataPaths are explicit plugin overrides. Runtime sockets may remain on
+// volatile State; these identity/reference databases must not be placed there.
+var MetadataPaths = map[string]string{
+	"io.cubelet.cubestore.v1.cubebox":        "cubebox",
+	"io.cubelet.cubemetastore.v1.mutilmeta":  "multimeta",
+	"io.cubelet.internal.v1.storage":         "storage",
+	"io.cubelet.internal.v1.volume":          "volume",
+	"io.cubelet.internal.v1.cgroup":          "cgroup",
+	"io.cubelet.internal.v1.network":         "network",
+	"io.cubelet.internal.v1.netfile":         "netfile",
+	"io.cubelet.internal.v1.images":          "images",
+	"io.cubelet.internal.v1.cleanup":         "cleanup",
+	"io.containerd.metadata.v1.bolt":         "containerd",
+	"io.containerd.snapshotter.v1.overlayfs": "overlayfs",
+}
+
+func within(path, root string) bool {
+	return path == root || strings.HasPrefix(path, root+string(filepath.Separator))
+}
+func ValidatePaths(root, state string, configured map[string]string, containerdNoSync *bool) error {
+	if !filepath.IsAbs(root) || filepath.Clean(root) != root || root == "/" || !filepath.IsAbs(state) || filepath.Clean(state) != state || within(root, state) || within(state, root) {
+		return errors.New("durable metadata root must be distinct from volatile state")
+	}
+	if containerdNoSync == nil || *containerdNoSync {
+		return errors.New("containerd metadata no_sync must explicitly be false")
+	}
+	for plugin, subdir := range MetadataPaths {
+		if configured[plugin] != filepath.Join(root, subdir) {
+			return fmt.Errorf("durable metadata plugin path missing or conflicting: %s", plugin)
+		}
+	}
+	return nil
+}
+
+// CheckFilesystem uses lstat on every existing component; no symlink or nested
+// unsupported mount may redirect one database back onto volatile storage.
+func CheckFilesystem(root string, paths map[string]string) error {
+	info, err := os.Lstat(root)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() || info.Mode().Perm() != 0700 {
+		return errors.New("operator-created private durable root required")
+	}
+	if err = checkOwnedRoot(info); err != nil {
+		return err
+	}
+	for _, path := range append([]string{root}, mapValues(paths)...) {
+		current := path
+		for {
+			st, err := os.Lstat(current)
+			if os.IsNotExist(err) {
+				current = filepath.Dir(current)
+				continue
+			}
+			if err != nil {
+				return err
+			}
+			if st.Mode()&os.ModeSymlink != 0 || !st.IsDir() {
+				return errors.New("durable metadata path contains a symlink or non-directory")
+			}
+			if current == root || within(current, root) {
+				if err = checkXFS(current); err != nil {
+					return err
+				}
+			}
+			if current == "/" {
+				break
+			}
+			current = filepath.Dir(current)
+		}
+	}
+	return checkMetadataTree(root, checkXFS)
+}
+
+func checkMetadataTree(root string, checkMount func(string) error) error {
+	// The overlay index shares its root with snapshotter filesystem contents.
+	// Validate the snapshots directory itself, never traverse image/guest trees.
+	snapshotContents := filepath.Join(root, "overlayfs", "io.containerd.snapshotter.v1.overlayfs", "snapshots")
+	count := 0
+	return filepath.WalkDir(root, func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		count++
+		if count > 100000 {
+			return errors.New("durable metadata tree exceeds inspection bound")
+		}
+		if d.Type()&os.ModeSymlink != 0 {
+			return errors.New("symlink inside durable metadata tree")
+		}
+		if d.IsDir() {
+			if err = checkMount(path); err != nil {
+				return err
+			}
+			if path == snapshotContents {
+				return filepath.SkipDir
+			}
+		}
+		return nil
+	})
+}
+func mapValues(m map[string]string) []string {
+	v := make([]string, 0, len(m))
+	for _, x := range m {
+		v = append(v, x)
+	}
+	return v
+}
+
+// Never silently switch away from a prior node's identity DBs. Operators must
+// fence and escrow/reconcile old state offline, then use an empty legacy namespace.
+// This function does not copy, unlink, open Bolt databases or execute cleanup.
+func CheckLegacyState(state string) error {
+	// Do not descend into runtime task/rootfs mounts or parse tenant files.
+	// Only prior plugin metadata directories and top-level database files matter.
+	names := []string{"io.cubelet.internal.v1.cubebox", "io.cubelet.cubestore.v1.cubebox", "io.cubelet.cubemetastore.v1.mutilmeta", "io.cubelet.internal.v1.storage", "io.cubelet.internal.v1.volume", "io.cubelet.internal.v1.cgroup", "io.cubelet.internal.v1.network", "io.cubelet.internal.v1.images", "io.cubelet.internal.v1.cleanup", "io.cubelet.internal.v1.netfile", "io.containerd.metadata.v1.bolt", "io.containerd.snapshotter.v1.overlayfs", "meta.db", "metadata.db"}
+	count := 0
+	for _, name := range names {
+		candidate := filepath.Join(state, name)
+		if _, err := os.Lstat(candidate); os.IsNotExist(err) {
+			continue
+		} else if err != nil {
+			return err
+		}
+		err := filepath.WalkDir(candidate, func(path string, d os.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			count++
+			if count > 100000 {
+				return errors.New("legacy state exceeds bounded inspection")
+			}
+			if d.Type()&os.ModeSymlink != 0 {
+				return errors.New("legacy metadata symlink requires operator review")
+			}
+			if !d.IsDir() && (strings.HasSuffix(d.Name(), ".db") || strings.HasSuffix(d.Name(), ".db.lock")) {
+				return errors.New("legacy metadata exists; refuse implicit migration")
+			}
+			return nil
+		})
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}

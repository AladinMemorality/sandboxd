@@ -0,0 +1,29 @@
+package cubebox
+
+import (
+	"encoding/json"
+	pb "github.com/tencentcloud/CubeSandbox/pkgs/proto/services/cubebox/v1"
+	"testing"
+)
+
+func TestPausePublicationFenceIsNotPersisted(t *testing.T) {
+	s := Status{PausedAt: 1, PauseCommitPending: true}
+	if s.State() != pb.ContainerState_CONTAINER_PAUSING {
+		t.Fatal("published uncommitted pause")
+	}
+	encoded, err := json.Marshal(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var committed Status
+	if err = json.Unmarshal(encoded, &committed); err != nil {
+		t.Fatal(err)
+	}
+	if committed.PauseCommitPending || committed.State() != pb.ContainerState_CONTAINER_PAUSED {
+		t.Fatal("durable record lost paused state")
+	}
+	s.PauseCommitPending = false
+	if s.State() != pb.ContainerState_CONTAINER_PAUSED {
+		t.Fatal("commit did not publish paused")
+	}
+}

--- a/Cubelet/plugins/cube/internals/cubes/persist_publish.go
+++ b/Cubelet/plugins/cube/internals/cubes/persist_publish.go
@@ -0,0 +1,12 @@
+package cubes
+
+// persistThenPublish prevents listeners from observing an acknowledged update
+// whose durable database transaction has failed. Readers of mutable in-memory
+// pause status are additionally fenced by Status.PauseCommitPending.
+func persistThenPublish(persist func() error, publish func()) error {
+	if err := persist(); err != nil {
+		return err
+	}
+	publish()
+	return nil
+}
--- a/Cubelet/plugins/cube/internals/cubes/persist_publish_test.go
+++ b/Cubelet/plugins/cube/internals/cubes/persist_publish_test.go
@@ -0,0 +1,25 @@
+package cubes
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestPersistenceFailureNeverPublishes(t *testing.T) {
+	called := false
+	err := persistThenPublish(func() error { return errors.New("injected sync failure") }, func() { called = true })
+	if err == nil || called {
+		t.Fatal("published failed transaction")
+	}
+}
+func TestPublicationRunsOnlyAfterCommit(t *testing.T) {
+	committed := false
+	err := persistThenPublish(func() error { committed = true; return nil }, func() {
+		if !committed {
+			t.Fatal("published before commit")
+		}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}

+package durability
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// SyncPauseArtifacts is deliberately XFS-only. It syncs current/rootfs/RAM
+// backing files and all small VMM/catalog metadata, then the filesystem ledger.
+// It never opens guest filesystems, runs guest code, or removes any source.
+func SyncPauseArtifacts(metadata string, objects ...string) error {
+	if !filepath.IsAbs(metadata) || filepath.Clean(metadata) != metadata {
+		return errors.New("invalid pause metadata directory")
+	}
+	if err := checkXFS(metadata); err != nil {
+		return err
+	}
+	info, err := os.Lstat(metadata)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.New("pause metadata must be a real directory")
+	}
+	device := info.Sys().(*syscall.Stat_t).Dev
+	syncFile := func(path string) error {
+		fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_CLOEXEC|syscall.O_NOFOLLOW, 0)
+		if err != nil {
+			return err
+		}
+		f := os.NewFile(uintptr(fd), path)
+		defer f.Close()
+		st, err := f.Stat()
+		if err != nil {
+			return err
+		}
+		if !st.Mode().IsRegular() || st.Sys().(*syscall.Stat_t).Dev != device {
+			return errors.New("pause artifact is not a regular file on the reviewed XFS")
+		}
+		if err = f.Sync(); err != nil {
+			return err
+		}
+		return SyncDirectories(filepath.Dir(path))
+	}
+	for _, path := range objects {
+		if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+			return errors.New("invalid current snapshot object path")
+		}
+		if err = syncFile(path); err != nil {
+			return err
+		}
+	}
+	count := 0
+	dirs := []string{}
+	err = filepath.WalkDir(metadata, func(path string, d os.DirEntry, e error) error {
+		if e != nil {
+			return e
+		}
+		count++
+		if count > 4096 {
+			return errors.New("pause metadata exceeds bounded file count")
+		}
+		if d.Type()&os.ModeSymlink != 0 {
+			return errors.New("pause metadata symlink requires explicit support")
+		}
+		if d.IsDir() {
+			st, e := d.Info()
+			if e != nil {
+				return e
+			}
+			if st.Sys().(*syscall.Stat_t).Dev != device {
+				return errors.New("unexpected mount inside pause metadata")
+			}
+			dirs = append(dirs, path)
+			return nil
+		}
+		return syncFile(path)
+	})
+	if err != nil {
+		return err
+	}
+	for i := len(dirs) - 1; i >= 0; i-- {
+		if err = SyncDirectories(dirs[i]); err != nil {
+			return err
+		}
+	}
+	// The pinned native cubecow ABI has no reviewed per-ledger flush primitive.
+	// syncfs supplies a conservative kernel-writeback barrier for this same XFS.
+	// User-space buffered native writes still require pinned-library validation.
+	f, err := os.Open(metadata)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	if err = unix.Syncfs(int(f.Fd())); err != nil {
+		return fmt.Errorf("pause XFS writeback failed: %w", err)
+	}
+	return nil
+}

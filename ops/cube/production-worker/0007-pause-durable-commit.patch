+// restorePauseIntentMetadata restores only this lifecycle operation's keys;
+// unrelated concurrent metadata updates must survive a failed intent write.
+func restorePauseIntentMetadata(sb *cubeboxstore.CubeBox, annotations, labels map[string]string) {
+	sb.MetaLock.Lock()
+	defer sb.MetaLock.Unlock()
+	restore := func(current, previous map[string]string) map[string]string {
+		result := maps.Clone(current)
+		if result == nil {
+			result = make(map[string]string)
+		}
+		for _, key := range []string{constants.MasterAnnotationPauseSnapshotID, constants.MasterAnnotationLaunchMemorySnapshotID} {
+			if value, exists := previous[key]; exists {
+				result[key] = value
+			} else {
+				delete(result, key)
+			}
+		}
+		return result
+	}
+	sb.Annotations = restore(sb.Annotations, annotations)
+	sb.Labels = restore(sb.Labels, labels)
+}

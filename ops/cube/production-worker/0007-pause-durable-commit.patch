@@ -0,0 +1,71 @@
+package durability
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+)
+
+func SyncDirectories(path string) error {
+	for {
+		f, err := os.Open(path)
+		if err != nil {
+			return err
+		}
+		err = f.Sync()
+		ce := f.Close()
+		if err != nil {
+			return err
+		}
+		if ce != nil {
+			return ce
+		}
+		parent := filepath.Dir(path)
+		if parent == path {
+			return nil
+		}
+		path = parent
+	}
+}
+
+// AtomicWrite acknowledges only after data, rename and all new parent links sync.
+func AtomicWrite(path string, data []byte, mode os.FileMode) error {
+	return atomicWrite(path, data, mode, func(f *os.File) error { return f.Sync() }, SyncDirectories, os.Rename)
+}
+func atomicWrite(path string, data []byte, mode os.FileMode, syncFile func(*os.File) error, syncDirs func(string) error, rename func(string, string) error) error {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return errors.New("canonical absolute metadata path required")
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".durable-metadata-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if err = f.Chmod(mode); err == nil {
+		_, err = f.Write(data)
+	}
+	if err == nil {
+		err = syncFile(f)
+	}
+	ce := f.Close()
+	if err != nil {
+		return err
+	}
+	if ce != nil {
+		return ce
+	}
+	if err = rename(name, path); err != nil {
+		return err
+	}
+	return syncDirs(filepath.Dir(path))
+}
+
+// CommitPauseBoundary must succeed before any caller destroys live storage or
+// acknowledges PAUSED. It intentionally has no cleanup callback on failure.
+func CommitPauseBoundary(syncArtifacts, persistPaused func() error) error {
+	if err := syncArtifacts(); err != nil {
+		return err
+	}
+	return persistPaused()
+}

+package durability
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestAtomicWriteSyncsBeforeRenameAndDirectoryAcknowledgement(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "catalog.json")
+	events := []string{}
+	err := atomicWrite(p, []byte("latest"), 0600, func(f *os.File) error { events = append(events, "file-sync"); return f.Sync() }, func(d string) error { events = append(events, "directory-sync"); return SyncDirectories(d) }, func(a, b string) error { events = append(events, "rename"); return os.Rename(a, b) })
+	if err != nil || !reflect.DeepEqual(events, []string{"file-sync", "rename", "directory-sync"}) {
+		t.Fatal(events, err)
+	}
+	b, _ := os.ReadFile(p)
+	if string(b) != "latest" {
+		t.Fatal("data missing")
+	}
+}
+func TestFileSyncFailurePreservesOldMetadataAndNeverRenames(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "catalog.json")
+	os.WriteFile(p, []byte("retained"), 0600)
+	called := false
+	err := atomicWrite(p, []byte("unacknowledged"), 0600, func(*os.File) error { return errors.New("EIO") }, func(string) error { called = true; return nil }, func(string, string) error { called = true; return nil })
+	b, _ := os.ReadFile(p)
+	if err == nil || called || string(b) != "retained" {
+		t.Fatal("durability failure escaped ordering")
+	}
+}
+func TestPauseBoundaryFailureNeverAdvancesOrAcknowledges(t *testing.T) {
+	persisted := false
+	err := CommitPauseBoundary(func() error { return errors.New("writeback failed") }, func() error { persisted = true; return nil })
+	if err == nil || persisted {
+		t.Fatal("persisted after barrier failure")
+	}
+	err = CommitPauseBoundary(func() error { return nil }, func() error { return errors.New("DB sync failed") })
+	if err == nil {
+		t.Fatal("DB failure acknowledged")
+	}
+}
+
+func TestDirectorySyncFailureCannotAcknowledgeRenamedMetadata(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "catalog.json")
+	if err := os.WriteFile(p, []byte("previous"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	err := atomicWrite(p, []byte("new-but-not-acknowledged"), 0600, func(f *os.File) error { return f.Sync() }, func(string) error { return errors.New("directory EIO") }, os.Rename)
+	if err == nil {
+		t.Fatal("acknowledged failed directory sync")
+	}
+	b, err := os.ReadFile(p)
+	if err != nil || string(b) != "new-but-not-acknowledged" {
+		t.Fatal("renamed recovery evidence removed", err)
+	}
+}

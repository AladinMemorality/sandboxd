--- a/Cubelet/pkg/store/cubebox/status_readers_test.go
+++ b/Cubelet/pkg/store/cubebox/status_readers_test.go
@@ -0,0 +1,79 @@
+package cubebox
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestStatusReadersAndPersistenceCopyShareCanonicalStatus(t *testing.T) {
+	box := &CubeBox{Metadata: Metadata{ID: "owned"}, ContainersMap: &ContainersMap{}}
+	main := &Container{Metadata: Metadata{ID: "owned"}, IsPod: true, Status: StoreStatus(Status{StartedAt: 1})}
+	box.AddContainer(main)
+	var jobs sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		jobs.Add(1)
+		go func() {
+			defer jobs.Done()
+			for i := 0; i < 1000; i++ {
+				if box.GetStatus() != main.Status {
+					t.Error("status reader lost canonical container")
+				}
+				copy := box.DeepCopy()
+				if copy.Status == nil || copy.Status.Get().StartedAt != 1 {
+					t.Error("persistence copy lost status")
+				}
+			}
+		}()
+	}
+	jobs.Wait()
+	if box.Status != nil {
+		t.Fatal("status readers mutated legacy pointer")
+	}
+}
+func TestStatusReadersInitializeOneFallback(t *testing.T) {
+	box := &CubeBox{Metadata: Metadata{ID: "owned", CreatedAt: 1}, ContainersMap: &ContainersMap{}}
+	values := make(chan *StatusStorage, 16)
+	var jobs sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		jobs.Add(1)
+		go func() { defer jobs.Done(); values <- box.GetStatus() }()
+	}
+	jobs.Wait()
+	close(values)
+	var first *StatusStorage
+	for status := range values {
+		if first == nil {
+			first = status
+		}
+		if status != first {
+			t.Fatal("duplicate mutable fallback")
+		}
+	}
+	if first.Get().CreatedAt != 1 {
+		t.Fatal("fallback identity lost")
+	}
+}
+
+func TestMetadataUpdatesAndPersistenceCopiesAreSynchronized(t *testing.T) {
+	box := &CubeBox{Metadata: Metadata{ID: "owned"}}
+	var jobs sync.WaitGroup
+	for worker := 0; worker < 4; worker++ {
+		jobs.Add(1)
+		go func() {
+			defer jobs.Done()
+			for i := 0; i < 500; i++ {
+				box.AddLabels(map[string]string{"pause": "owned-snapshot"})
+				box.AddAnnotations(map[string]string{"generation": "current"})
+				copy := box.DeepCopy()
+				if copy.ID != "owned" {
+					t.Error("identity changed")
+				}
+			}
+		}()
+	}
+	jobs.Wait()
+	copy := box.DeepCopy()
+	if copy.Labels["pause"] != "owned-snapshot" || copy.Annotations["generation"] != "current" {
+		t.Fatal("metadata update lost")
+	}
+}

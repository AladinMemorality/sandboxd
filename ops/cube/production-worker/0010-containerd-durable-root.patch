+package plugin
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	srvconfig "github.com/containerd/containerd/v2/cmd/containerd/server/config"
+	"github.com/containerd/containerd/v2/core/events"
+	"github.com/containerd/containerd/v2/core/metadata"
+	"github.com/containerd/containerd/v2/core/snapshots"
+	"github.com/containerd/containerd/v2/plugins"
+	"github.com/containerd/containerd/v2/plugins/content/local"
+	"github.com/containerd/plugin"
+	"github.com/containerd/plugin/registry"
+	"github.com/pelletier/go-toml/v2"
+	bolt "go.etcd.io/bbolt"
+)
+
+type discardPublisher struct{}
+
+func (discardPublisher) Publish(context.Context, string, events.Event) error { return nil }
+
+type inertSnapshotter struct{ snapshots.Snapshotter }
+
+// Use the registered real InitFn and the same server Config.Decode path as the
+// plugin loader. A TOML-shape-only test missed the ignored root_path regression.
+func loadMetadata(t *testing.T, root, state string, noSync bool) (*metadata.DB, *bolt.DB, *plugin.InitContext, error) {
+	t.Helper()
+	ctx := context.Background()
+	set := plugin.NewPluginSet()
+	cs, err := local.NewStore(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for typ, instance := range map[plugin.Type]interface{}{plugins.ContentPlugin: cs, plugins.EventPlugin: discardPublisher{}, plugins.SnapshotPlugin: inertSnapshotter{}} {
+		r := plugin.Registration{Type: typ, ID: "fixture", InitFn: func(*plugin.InitContext) (interface{}, error) { return instance, nil }}
+		if err := set.Add(r.Init(plugin.NewContext(ctx, set, nil))); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var registered *plugin.Registration
+	for _, reg := range registry.Graph(func(*plugin.Registration) bool { return false }) {
+		if reg.Type == plugins.MetadataPlugin && reg.ID == "bolt" {
+			copy := reg
+			registered = &copy
+			break
+		}
+	}
+	if registered == nil {
+		t.Fatal("real metadata registration missing")
+	}
+	text := fmt.Sprintf("version=3\n[plugins.\"io.containerd.metadata.v1.bolt\"]\nroot_path=%q\nno_sync=%t\ncontent_sharing_policy=\"shared\"\n", root, noSync)
+	var config srvconfig.Config
+	if err := toml.Unmarshal([]byte(text), &config); err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := config.Decode(ctx, registered.URI(), &BoltConfig{ContentSharingPolicy: SharingPolicyShared})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ic := plugin.NewContext(ctx, set, map[string]string{plugins.PropertyStateDir: state})
+	ic.Config = decoded
+	result := registered.Init(ic)
+	instance, err := result.Instance()
+	if err != nil {
+		return nil, nil, ic, err
+	}
+	mdb := instance.(*metadata.DB)
+	var db *bolt.DB
+	if err := mdb.View(func(tx *bolt.Tx) error { db = tx.DB(); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	return mdb, db, ic, nil
+}
+
+func TestRegisteredMetadataPluginOpensAndReopensDurableRoot(t *testing.T) {
+	base := t.TempDir()
+	root := filepath.Join(base, "persistent", "containerd")
+	state := filepath.Join(base, "volatile-state")
+	mdb, db, ic, err := loadMetadata(t, root, state, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if db != nil {
+			_ = db.Close()
+		}
+	}()
+	expected := filepath.Join(root, "meta.db")
+	if db.Path() != expected || ic.Meta.Exports["path"] != expected {
+		t.Fatalf("actual DB path %q, want %q", db.Path(), expected)
+	}
+	if db.NoSync || db.NoGrowSync {
+		t.Fatal("actual DB configured asynchronous")
+	}
+	if err := mdb.Update(func(tx *bolt.Tx) error {
+		b, e := tx.CreateBucketIfNotExists([]byte("durability-fixture"))
+		if e != nil {
+			return e
+		}
+		return b.Put([]byte("latest"), []byte("acknowledged"))
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	db = nil
+	if _, err := os.Stat(state); !os.IsNotExist(err) {
+		t.Fatalf("volatile State unexpectedly created: %v", err)
+	}
+	mdb, reopened, _, err := loadMetadata(t, root, state, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db = reopened
+	if err := mdb.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket([]byte("durability-fixture"))
+		if b == nil || string(b.Get([]byte("latest"))) != "acknowledged" {
+			t.Fatal("latest metadata lost on reopen")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRegisteredMetadataPluginRejectsUnsafeExplicitRoot(t *testing.T) {
+	for _, tc := range []struct {
+		root  string
+		async bool
+	}{{"relative", false}, {filepath.Join(t.TempDir(), "durable"), true}} {
+		state := filepath.Join(t.TempDir(), "state")
+		_, db, _, err := loadMetadata(t, tc.root, state, tc.async)
+		if db != nil {
+			_ = db.Close()
+		}
+		if err == nil {
+			t.Fatal("unsafe explicit root accepted")
+		}
+		if _, e := os.Stat(state); !os.IsNotExist(e) {
+			t.Fatal("invalid config created volatile fallback")
+		}
+	}
+}
+
+func TestRegisteredMetadataPluginPreservesUnconfiguredLegacyPath(t *testing.T) {
+	state := filepath.Join(t.TempDir(), "state")
+	_, db, _, err := loadMetadata(t, "", state, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if db.Path() != filepath.Join(state, "meta.db") {
+		t.Fatal("unexpected legacy path")
+	}
+}

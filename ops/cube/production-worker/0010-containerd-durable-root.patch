@@ -0,0 +1,84 @@
+package backup
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/metadata"
+	"github.com/containerd/containerd/v2/plugins"
+	"github.com/containerd/plugin"
+	"github.com/containerd/plugin/registry"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/constants"
+	bolt "go.etcd.io/bbolt"
+)
+
+func TestRegisteredBackupUsesActualPersistentMetadataDatabase(t *testing.T) {
+	base := t.TempDir()
+	source := filepath.Join(base, "actual-durable-meta.db")
+	db, err := bolt.Open(source, 0600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if err := db.Update(func(tx *bolt.Tx) error {
+		b, e := tx.CreateBucketIfNotExists([]byte("fixture"))
+		if e != nil {
+			return e
+		}
+		return b.Put([]byte("latest"), []byte("persistent"))
+	}); err != nil {
+		t.Fatal(err)
+	}
+	md := metadata.NewDB(db, nil, nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel() // disable background ticker work
+	set := plugin.NewPluginSet()
+	reg := plugin.Registration{Type: plugins.MetadataPlugin, ID: "bolt", InitFn: func(*plugin.InitContext) (interface{}, error) { return md, nil }}
+	if err := set.Add(reg.Init(plugin.NewContext(ctx, set, nil))); err != nil {
+		t.Fatal(err)
+	}
+	var backupReg *plugin.Registration
+	for _, r := range registry.Graph(func(*plugin.Registration) bool { return false }) {
+		if r.Type == constants.InternalPlugin && r.ID == constants.BackupID.ID() {
+			copy := r
+			backupReg = &copy
+			break
+		}
+	}
+	if backupReg == nil {
+		t.Fatal("registered backup plugin absent")
+	}
+	ic := plugin.NewContext(ctx, set, nil)
+	ic.Config = &Config{RootPath: filepath.Join(base, "backups"), BackupPeriod: "24h"}
+	instance, err := backupReg.Init(ic).Instance()
+	if err != nil {
+		t.Fatal(err)
+	}
+	local := instance.(*Local)
+	if len(local.jobs) != 1 || local.jobs[0].Source != source {
+		t.Fatalf("backup did not use actual open database: %+v", local.jobs)
+	}
+	if err := local.backup(); err != nil {
+		t.Fatal(err)
+	}
+	target := filepath.Join(local.jobs[0].TargetDir, filepath.Base(source))
+	if _, err := os.Stat(target); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := bolt.Open(target, 0600, &bolt.Options{ReadOnly: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restored.Close()
+	if err := restored.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket([]byte("fixture"))
+		if b == nil || string(b.Get([]byte("latest"))) != "persistent" {
+			t.Fatal("backup omitted latest metadata")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}

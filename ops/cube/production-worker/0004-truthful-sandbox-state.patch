+
+// Neither an unavailable task nor a successful update response proves that
+// an app is running. Do not trigger pause-snapshot restoration for dead tasks.
+fn ensure_connectable_status(status: &SandboxStatus) -> AppResult<()> {
+    if matches!(status, SandboxStatus::Running | SandboxStatus::Paused) {
+        return Ok(());
+    }
+    Err(sandbox_not_ready())
+}
+
+fn ensure_running_status(status: &SandboxStatus) -> AppResult<()> {
+    if *status == SandboxStatus::Running {
+        return Ok(());
+    }
+    Err(sandbox_not_ready())
+}
+
+fn sandbox_not_ready() -> AppError {
+    AppError::ServiceUnavailable {
+        message: "sandbox is not running; recovery or readiness verification is required"
+            .to_string(),
+        retry_after: 2,
     }
 }
 

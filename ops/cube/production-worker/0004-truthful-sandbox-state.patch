+    async fn recovery_service(status: i32, after_update: i32) -> (SandboxService, RecoveryFixture) {
+        let fixture = RecoveryFixture {
+            status: Arc::new(Mutex::new(status)),
+            after_update,
+            updates: Arc::new(Mutex::new(0)),
+        };
+        let service = spawn_fake_cubemaster(
+            Router::new()
+                .route("/cube/sandbox/info", axum::routing::get(recovery_info))
+                .route("/cube/sandbox/update", post(recovery_update))
+                .with_state(fixture.clone()),
+        )
+        .await;
+        (service, fixture)
+    }
+
+    async fn assert_recovery_unavailable(error: AppError) {
+        let response = error.into_response();
+        assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+        assert_eq!(response.headers()[RETRY_AFTER], "2");
+        let body = axum::body::to_bytes(response.into_body(), 4096)
+            .await
+            .unwrap();
+        let text = std::str::from_utf8(&body).unwrap();
+        assert!(text.contains("sandbox is not running"));
+        assert!(!text.contains("owned"));
+        assert!(!text.contains("token"));
+        assert!(!text.contains("/data/"));
+    }
+
+    #[tokio::test]
+    async fn recovery_unknown_and_stopped_get_are_truthful_and_never_mutate() {
+        for (state, expected) in [
+            (0, SandboxState::Unknown),
+            (2, SandboxState::Stopped),
+            (3, SandboxState::Unknown),
+            (4, SandboxState::Pausing),
+            (99, SandboxState::Unknown),
+        ] {
+            let (service, fixture) = recovery_service(state, 1).await;
+            let got = service.get_sandbox("owned").await.unwrap();
+            assert_eq!(got.state, expected);
+            assert_eq!(got.template_id, "tpl-owned");
+            assert_eq!(got.cpu_count, 2);
+            assert_eq!(got.memory_mb, 2048);
+            assert_recovery_unavailable(service.connect_sandbox("owned", None).await.unwrap_err())
+                .await;
+            assert_recovery_unavailable(service.resume_sandbox("owned", None).await.unwrap_err())
+                .await;
+            assert_eq!(*fixture.updates.lock().await, 0);
+        }
+    }
+
+    #[tokio::test]

[Unit]
Description=Observe pinned B200 worker and backing storage for Cube admission
After=network-online.target cube-fleet-observer-transport.service
Wants=cube-fleet-observer-transport.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/baarcha-cube/fleet-worker/observe.py --worker b200-01 --config /etc/baarcha-cube/storage-guard-b200.json
TimeoutStartSec=20
CPUQuota=25%
MemoryMax=96M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sandboxd/cube-storage-observer-b200 /run/sandboxd-cube-storage-b200
RuntimeDirectory=sandboxd-cube-storage-b200
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

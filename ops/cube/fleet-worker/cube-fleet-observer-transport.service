[Unit]
Description=Private SSH transport for the forced read-only B200 storage probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=cube-fleet-observer
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/ssh -MN -o ControlMaster=yes -o ControlPersist=no -o ControlPath=/run/cube-fleet-observer/host.sock -i /etc/baarcha-cube/fleet-observer/key -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=4 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/baarcha-cube/fleet-observer/known_hosts -p 7722 user4@10.40.14.68
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target

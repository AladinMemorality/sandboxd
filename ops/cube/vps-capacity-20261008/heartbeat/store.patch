+// equalJSON tolerates MySQL's normalization of JSON whitespace and key order.
+// UseNumber avoids treating distinct large integer values as the same float.
+func equalJSON(a, b string) bool {
+	if a == b {
+		return true
+	}
+	var av, bv any
+	ad, bd := json.NewDecoder(strings.NewReader(a)), json.NewDecoder(strings.NewReader(b))
+	ad.UseNumber()
+	bd.UseNumber()
+	return ad.Decode(&av) == nil && bd.Decode(&bv) == nil && reflect.DeepEqual(av, bv)
+}
+
+// Inventory is an unordered multiset. Cubelet reports it from maps, so a
+// harmless change in enumeration order must not rewrite the whole inventory.
+// Sort canonical entries while preserving duplicates and all field values.
+func equalInventoryJSON(a, b string) bool {
+	if equalJSON(a, b) {
+		return true
+	}
+	normalize := func(raw string) ([]string, bool) {
+		var entries []json.RawMessage
+		if json.Unmarshal([]byte(raw), &entries) != nil || entries == nil {
+			return nil, false
+		}
+		out := make([]string, 0, len(entries))
+		for _, entry := range entries {
+			var v any
+			d := json.NewDecoder(strings.NewReader(string(entry)))
+			d.UseNumber()
+			if d.Decode(&v) != nil {
+				return nil, false
+			}
+			encoded, e := json.Marshal(v)
+			if e != nil {
+				return nil, false
+			}
+			out = append(out, string(encoded))
+		}
+		sort.Strings(out)
+		return out, true
+	}
+	av, aok := normalize(a)
+	bv, bok := normalize(b)
+	return aok && bok && reflect.DeepEqual(av, bv)
+}

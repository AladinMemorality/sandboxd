diff --git a/CubeProxy/lua/redis_iresty.lua b/CubeProxy/lua/redis_iresty.lua
index fd88e75..9bf3451 100644
--- a/CubeProxy/lua/redis_iresty.lua
+++ b/CubeProxy/lua/redis_iresty.lua
@@ -205,6 +205,23 @@ local function is_redis_null(res)
     return false
 end
 
+-- Pools are worker-local. Use opaque identities so passwords cannot appear in
+-- cosocket diagnostics, while endpoint, credential and DB changes get a new
+-- pool. Only fully initialized, unchanged sessions are returned to these pools.
+local session_pools, next_pool = {}, 0
+local function connect_pooled(self, redis, host, port)
+    local password = self.redis_pd
+    local identity = #host .. ":" .. host .. ":" .. tostring(port) .. ":" ..
+        #password .. ":" .. password .. ":" .. tostring(self.redis_index)
+    local pool = session_pools[identity]
+    if not pool then
+        next_pool = next_pool + 1
+        pool = "cube-redis-session-" .. next_pool
+        session_pools[identity] = pool
+    end
+    return redis:connect(host, port, { pool = pool })
+end
+
 function _M.connect_mod(self, redis)
     redis:set_timeout(self.timeout)
     if sentinel_mode(self) then
@@ -213,7 +230,7 @@ function _M.connect_mod(self, redis)
         -- cache entry and fall through to a fresh Sentinel lookup.
         local cip, cport = get_cached_master(self)
         if cip then
-            local ok = redis:connect(cip, cport)
+            local ok = connect_pooled(self, redis, cip, cport)
             if ok then
                 return ok
             end
@@ -225,14 +242,14 @@ function _M.connect_mod(self, redis)
         end
         -- Cache only after connect succeeds so a transient failure does not
         -- leave a stale address that forces an extra failed connect cycle.
-        local ok, cerr = redis:connect(ip, port)
+        local ok, cerr = connect_pooled(self, redis, ip, port)
         if not ok then
             return nil, cerr
         end
         set_cached_master(self, ip, port)
         return ok
     end
-    return redis:connect(self.redis_ip, self.redis_port)
+    return connect_pooled(self, redis, self.redis_ip, self.redis_port)
 end
 
 function _M.auth_mod(self, redis)
@@ -243,11 +260,36 @@ function _M.select_mod(self, redis)
     return redis:select(self.redis_index)
 end
 
-function _M.set_keepalive_mod(redis)
+local session_commands = {
+    auth = true, select = true, client = true, multi = true, exec = true,
+    discard = true, watch = true, unwatch = true, monitor = true,
+    sync = true, psubscribe = true, quit = true, shutdown = true,
+}
+
+function _M.set_keepalive_mod(redis, commands)
+    for _, cmd in ipairs(commands) do
+        if session_commands[cmd[1]] then
+            return redis:close()
+        end
+    end
     -- put it into the connection pool of size 100, with 60 seconds max idle time
     return redis:set_keepalive(60000, 1000)
 end
 
+local function connect_initialized(self, redis)
+    local ok, err = self:connect_mod(redis)
+    if not ok then return nil, err end
+    local reused = redis:get_reused_times()
+    if type(reused) == "number" and reused > 0 then return true end
+    ok, err = self:auth_mod(redis)
+    if ok and not err then ok, err = self:select_mod(redis) end
+    if not ok or err then
+        pcall(function() redis:close() end)
+        return nil, err
+    end
+    return true
+end
+
 function _M.init_pipeline(self)
     self._reqs = {}
 end
@@ -258,23 +300,11 @@ local function exec_pipeline(self, reqs)
         return nil, err
     end
 
-    local ok, cerr = self:connect_mod(redis)
+    local ok, cerr = connect_initialized(self, redis)
     if not ok then
         return {}, cerr
     end
 
-    ok, err = self:auth_mod(redis)
-    if not ok or err then
-        pcall(function() redis:close() end)
-        return {}, err
-    end
-
-    ok, err = self:select_mod(redis)
-    if not ok or err then
-        pcall(function() redis:close() end)
-        return {}, err
-    end
-
     redis:init_pipeline()
     for _, vals in ipairs(reqs) do
         local fun = redis[vals[1]]
@@ -297,7 +327,7 @@ local function exec_pipeline(self, reqs)
         ngx.log(ngx.WARN, "is null")
     end
 
-    self.set_keepalive_mod(redis)
+    self.set_keepalive_mod(redis, reqs)
 
     for i = 1, #results do
         if is_redis_null(results[i]) then
@@ -358,23 +388,11 @@ local function exec_command(self, cmd, ...)
         return nil, err
     end
 
-    local ok, cerr = self:connect_mod(redis)
+    local ok, cerr = connect_initialized(self, redis)
     if not ok or cerr then
         return nil, cerr
     end
 
-    ok, err = self:auth_mod(redis)
-    if not ok or err then
-        pcall(function() redis:close() end)
-        return nil, err
-    end
-
-    ok, err = self:select_mod(redis)
-    if not ok or err then
-        pcall(function() redis:close() end)
-        return nil, err
-    end
-
     local fun = redis[cmd]
     local result, rerr = fun(redis, ...)
     if not result or rerr then
@@ -386,7 +404,7 @@ local function exec_command(self, cmd, ...)
         result = nil
     end
 
-    self.set_keepalive_mod(redis)
+    self.set_keepalive_mod(redis, {{cmd}})

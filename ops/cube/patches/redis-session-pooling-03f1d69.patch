 end
 
diff --git a/CubeProxy/tests/redis_iresty_live_pool.lua b/CubeProxy/tests/redis_iresty_live_pool.lua
new file mode 100644
index 0000000..ce7011d
--- /dev/null
+++ b/CubeProxy/tests/redis_iresty_live_pool.lua
@@ -0,0 +1,19 @@
+-- Operator-only, read-only PING checks against the configured Redis endpoint.
+-- Run with resty -I <candidate lua directory> and a private JSON config file.
+local json = require "cjson.safe"
+local f = assert(io.open(assert(arg[1]), "r"))
+local opts = assert(json.decode(f:read("*a"))); f:close()
+local wrapper = require "redis_iresty"
+local timings = {}
+for i = 1, 5 do
+    ngx.update_time(); local start = ngx.now()
+    local result, err = wrapper:new(opts):ping()
+    assert(result == "PONG" and not err, "Redis PING failed")
+    ngx.update_time(); timings[i] = math.floor((ngx.now() - start) * 1000 + 0.5)
+end
+local bad = {}
+for k, v in pairs(opts) do bad[k] = v end
+bad.redis_pd = "invalid-isolation-test-password"
+local result, err = wrapper:new(bad):ping()
+assert(not result and err, "invalid credentials reused an authenticated session")
+print(assert(json.encode({ ping_ms = timings, credential_isolation = true })))
diff --git a/CubeProxy/tests/redis_iresty_pool_test.lua b/CubeProxy/tests/redis_iresty_pool_test.lua
new file mode 100644
index 0000000..728f70f
--- /dev/null
+++ b/CubeProxy/tests/redis_iresty_pool_test.lua
@@ -0,0 +1,76 @@
+-- Shared command/pipeline session reuse, identity isolation and failure cleanup.
+package.path = "./lua/?.lua;" .. package.path
+ngx = { null = {}, WARN = "WARN", shared = {}, log = function() end }
+local pools, calls = {}, { auth = 0, select = 0, commands = 0, close = 0 }
+local fail_auth, fail_select = false, false
+package.loaded["resty.redis"] = { new = function()
+    local r = {}
+    function r:set_timeout() end
+    function r:connect(host, port, options)
+        self.pool = options and options.pool or host .. ":" .. port
+        self.session = pools[self.pool] or { reused = 0 }
+        pools[self.pool] = nil
+        return true
+    end
+    function r:get_reused_times() return self.session.reused end
+    function r:auth(password)
+        calls.auth = calls.auth + 1
+        if fail_auth then return nil, "WRONGPASS" end
+        self.session.password = password
+        return "OK"
+    end
+    function r:select(db)
+        calls.select = calls.select + 1
+        if fail_select then return nil, "invalid DB" end
+        self.session.db = db
+        return "OK"
+    end
+    function r:get()
+        calls.commands = calls.commands + 1
+        if self.pipeline then self.pipeline[#self.pipeline + 1] = true; return true end
+        return self.session.password .. ":" .. self.session.db
+    end
+    function r:init_pipeline() self.pipeline = {} end
+    function r:commit_pipeline()
+        local result = {}
+        for i = 1, #self.pipeline do result[i] = self.session.password .. ":" .. self.session.db end
+        self.pipeline = nil
+        return result
+    end
+    function r:set_keepalive()
+        self.session.reused = self.session.reused + 1
+        pools[self.pool] = self.session
+        return true
+    end
+    function r:close() calls.close = calls.close + 1 end
+    return r
+end }
+local wrapper = require "redis_iresty"
+local function client(password, db, host)
+    return wrapper:new({ redis_ip = host or "redis.test", redis_port = 6379, redis_pd = password or "first", redis_index = db or 0 })
+end
+assert(client():get("key") == "first:0")
+assert(client():get("key") == "first:0")
+local piped = client(); piped:init_pipeline(); piped:get("key")
+assert(piped:commit_pipeline()[1] == "first:0")
+assert(calls.auth == 1 and calls.select == 1, "reused command and pipeline sessions must initialize once")
+assert(client("second", 0):get("key") == "second:0", "credential rotation must use its own pool")
+assert(client("first", 1):get("key") == "first:1", "database must partition the pool")
+assert(client("first", 0, "another.test"):get("key") == "first:0", "endpoint must partition the pool")
+for name in pairs(pools) do assert(not name:find("first", 1, true) and not name:find("second", 1, true), "pool names must not reveal passwords") end
+-- Explicit session-changing commands must not contaminate another client.
+assert(client():select(7))
+assert(client():get("key") == "first:0", "SELECT leaked to the next request")
+local prior = calls.commands
+fail_auth = true
+local value, err = client("bad-auth"):get("key")
+assert(not value and err == "WRONGPASS" and calls.commands == prior, "failed AUTH must not execute commands")
+fail_auth = false; fail_select = true
+local bad = client("bad-db"); bad:init_pipeline(); bad:get("key")
+value, err = bad:commit_pipeline()
+assert(err == "invalid DB" and calls.commands == prior, "failed SELECT must not execute a pipeline")
+fail_select = false
+assert(client("bad-auth"):get("key") == "bad-auth:0", "failed initialization must not be pooled")
+assert(client("bad-db"):get("key") == "bad-db:0")
+assert(calls.close >= 3, "session mutation and initialization failures must close their connections")
+print("redis_iresty pooled session tests OK")

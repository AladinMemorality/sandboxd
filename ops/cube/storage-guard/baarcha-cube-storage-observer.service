[Unit]
Description=Observe pinned Cube worker and backing storage for admission
After=network-online.target baarcha-cube-worker-01.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/baarcha-cube/storage-guard/observe.py --config /etc/baarcha-cube/storage-guard.json
TimeoutStartSec=20
CPUQuota=25%
MemoryMax=96M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sandboxd/cube-storage-observer /run/sandboxd-cube-storage
RuntimeDirectory=sandboxd-cube-storage
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# State directory must be independently provisioned root0700; preserve generation.
